# ==============================================================================
# MONCV.AI - MODÈLE DE VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# Copiez ce fichier vers .env.local et renseignez vos véritables clés secrètes :
# cp .env.example .env.local
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
NEXTAUTH_SECRET=remplacer_par_une_cle_secrete_jwt_longue

# ==============================================================================
# SÉCURITÉ CONSOLE ADMIN & PRÉVISUALISATION (OBLIGATOIRE EN PRODUCTION)
# ==============================================================================
# Clé secrète HMAC 256 bits pour la signature des jetons administrateur (générer aléatoirement : openssl rand -hex 32)
ADMIN_SECRET_KEY=votre_cle_secrete_hmac_admin_tres_longue_et_aleatoire
# Passphrase maître du SuperAdmin (haute entropie, 20+ caractères)
ADMIN_MASTER_PASSKEY=votre_passphrase_maitre_superadmin_forte
# Clés de secours optionnelles séparées par des virgules
ADMIN_BACKUP_KEYS=
# Emails autorisés pour l'accès SuperAdmin (séparés par des virgules)
ADMIN_ALLOWED_EMAILS=innovagroup225@gmail.com,admin@moncv.ai

# Sas de prévisualisation privée (Preview Lock)
PREVIEW_PASSWORD=mot_de_passe_acces_preview_confidentiel
PREVIEW_SECRET_KEY=cle_secrete_hmac_preview_aleatoire_32_octets

# Intelligence Artificielle (ATS & STAR)
OPENAI_API_KEY=votre_cle_openai_ici
GEMINI_API_KEY=votre_cle_gemini_ici
ANTHROPIC_API_KEY=votre_cle_anthropic_ici

# ==============================================================================
# PAIEMENTS KKIAPAY (BÉNIN, CÔTE D'IVOIRE, TOGO, SÉNÉGAL, ETC. - WAVE, MOMO, MOOV, CARTE)
# ==============================================================================
# Clé publique KKiaPay (exposée au navigateur pour afficher le widget)
NEXT_PUBLIC_KKIAPAY_PUBLIC_KEY=pk_test_votre_cle_publique_kkiapay
# Mode sandbox (true en local/staging, false impératif en production Vercel)
NEXT_PUBLIC_KKIAPAY_SANDBOX=true
# Clé privée KKiaPay (SERVEUR UNIQUEMENT - ne jamais exposer)
KKIAPAY_PRIVATE_KEY=pk_live_or_test_votre_cle_privee_kkiapay
# Clé secrète KKiaPay (SERVEUR UNIQUEMENT - ne jamais exposer)
KKIAPAY_SECRET=votre_cle_secrete_kkiapay
# Secret du Webhook KKiaPay (SERVEUR UNIQUEMENT - configuré dans le dashboard KKiaPay)
KKIAPAY_WEBHOOK_SECRET=votre_secret_webhook_kkiapay

# Autres passerelles
# Passerelle Panafricaine LigdiCash (Orange, MTN, Moov, Wave, Carte)
LIGDICASH_API_KEY=votre_cle_api_marchand_ligdicash
LIGDICASH_API_TOKEN=votre_jeton_bearer_ligdicash
LIGDICASH_WEBHOOK_SECRET=votre_secret_signature_webhook_ligdicash
LIGDICASH_BASE_URL=https://app.ligdicash.com/pay/v01
LIGDICASH_PLATFORM=live

WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
MTN_MOMO_PRIMARY_KEY=
MTN_MOMO_API_USER_ID=
MTN_MOMO_API_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Emails & Notifications
RESEND_API_KEY=
EMAIL_FROM="MonCV.ai <notifications@moncv.ai>"

# Base de données Cloud Supabase (PostgreSQL, Auth & Service Role)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_publique_anon_supabase
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete_supabase
DATABASE_URL=
